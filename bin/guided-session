#!/usr/bin/env bash
# Runs at the first prompt of `min session attach` (the loadout's
# PROMPT_COMMAND): signs in to GitHub, writes ~/.claude/CLAUDE.md from your
# settings, and starts Claude Code. Quitting Claude leaves a plain shell.
#
# Not `set -e`: a failed step must still get the user to Claude.
set -uo pipefail

# shellcheck source=/dev/null
[ -f "$HOME/.config/claude-guided/config" ] && . "$HOME/.config/claude-guided/config"

bold='' reset=''
if [ -t 1 ]; then bold=$'\e[1m' reset=$'\e[0m'; fi

# git over HTTPS through gh, since the sandbox has no SSH keys.
if command -v gh >/dev/null 2>&1; then
  if ! gh auth status >/dev/null 2>&1 && [ -t 0 ]; then
    printf '\n%sSign in to GitHub%s so Claude can open pull requests for you.\n' "$bold" "$reset"
    printf 'Open %shttps://github.com/login/device%s in your browser and enter the code below.\n\n' "$bold" "$reset"
    # The answers gh would ask for are fixed here. The session has no browser
    # to open, so GH_BROWSER=true turns gh's attempt into a quiet no-op.
    GH_BROWSER=true gh auth login --hostname github.com --git-protocol https --web \
      --scopes user:email || printf '\nGitHub sign-in did not finish. Ask Claude to help you sign in.\n'
  fi
  touch "$HOME/.gitconfig"
  gh auth setup-git 2>/dev/null || true
fi

# Git identity: GIT_USER_NAME / GIT_USER_EMAIL from the config win. A value
# left unset keeps what dotfiles set, and otherwise comes from the GitHub
# account just signed in: its name (or login), and its primary email when
# gh's token can read it, then its public one, then GitHub's noreply address,
# which still links commits to the account.
git_name="${GIT_USER_NAME:-$(git config --global user.name)}"
git_email="${GIT_USER_EMAIL:-$(git config --global user.email)}"
if { [ -z "$git_name" ] || [ -z "$git_email" ]; } && gh auth status >/dev/null 2>&1; then
  IFS=$'\t' read -r gh_login gh_id gh_name gh_email < <(
    gh api user --jq '[.login, .id, (.name // ""), (.email // "")] | @tsv' 2>/dev/null)
  if [ -n "${gh_login:-}" ]; then
    primary="$(gh api user/emails --jq 'map(select(.primary))[0].email // empty' 2>/dev/null)" ||
      primary=""
    git_name="${git_name:-${gh_name:-$gh_login}}"
    git_email="${git_email:-${primary:-${gh_email:-$gh_id+$gh_login@users.noreply.github.com}}}"
  fi
fi
[ -n "$git_name" ] && git config --global user.name "$git_name"
[ -n "$git_email" ] && git config --global user.email "$git_email"

# Claude Code asks whether to trust every folder it hasn't seen, and each
# session's project folder is new. Activating the project is that decision.
if command -v jq >/dev/null 2>&1; then
  cj="$HOME/.claude.json"
  [ -f "$cj" ] || echo '{}' >"$cj"
  jq --arg p "$PWD" '.projects[$p].hasTrustDialogAccepted = true' "$cj" >"$cj.tmp" &&
    mv "$cj.tmp" "$cj"
fi

origin_url="$(git remote get-url origin 2>/dev/null || true)"
case "$origin_url" in
  git@github.com:*) git remote set-url origin "https://github.com/${origin_url#git@github.com:}" ;;
esac

template="$HOME/.local/share/claude-guided/CLAUDE.md.in"
if [ -f "$template" ]; then
  reviewer="${GUIDED_REVIEWER:-}"
  reviewer="${reviewer// /}"
  if [ -n "$reviewer" ]; then
    reviewer_text="Request a review from @${reviewer//,/, @} (\`--reviewer $reviewer\`)."
  else
    reviewer_text="Don't request reviewers; the repository assigns them."
  fi
  if [ "${GUIDED_AUTOSHIP:-true}" = true ]; then
    ship="**Get it ready for review.** If the project has a \`/shipit\` command, run it. Otherwise watch the checks (\`gh pr checks --watch\`), fix anything that fails, and address automated review comments, until the checks pass."
  else
    ship="**Stop here** once the pull request is open; the reviewer takes it from there."
  fi
  mkdir -p "$HOME/.claude"
  awk -v r="$reviewer_text" -v s="$ship" \
    '{ gsub(/@@REVIEWER@@/, r); gsub(/@@SHIP_STEP@@/, s); print }' \
    "$template" >"$HOME/.claude/CLAUDE.md"
fi

printf '\n%sHi! Tell Claude what you would like to change.%s\n' "$bold" "$reset"
printf 'It will show you the result, then open a pull request for review.\n\n'

read -ra extra <<<"${CLAUDE_ARGS:-}"

# The first attach opens with Claude's welcome (the "First message" section
# of CLAUDE.md); later attaches go straight to the prompt.
welcomed="$HOME/.local/state/claude-guided/welcomed"
if [ ! -f "$welcomed" ]; then
  mkdir -p "${welcomed%/*}" && touch "$welcomed"
  extra+=("Welcome me to this session.")
fi
bash "$HOME/.local/bin/claude-launch" --permission-mode "${GUIDED_PERMISSION_MODE:-auto}" ${extra[@]+"${extra[@]}"}

printf '\nClaude has stopped. Type %sclaude-launch%s and press Enter to start it again.\n' "$bold" "$reset"
