#!/usr/bin/env bash
# Says whether a pull request is ready for its reviewer, from GitHub alone, so
# Claude acts on a state instead of its own reading of the PR page.
#
#   pr-ready [PR] [--wait [SECONDS]]
#
# PR defaults to the current branch's pull request. The first output line is
# `STATE: <state>`; the lines after it say why. The exit code is the state:
#
#   0 ready    every check passed, no open review thread, no reviewer waiting
#   1 action   something to fix: a failed check, an open thread, requested
#              changes from a bot, or a merge conflict
#   2 waiting  checks still running, or a bot has not reviewed the latest commit
#   3 error    GitHub could not be read
#   4 person   only a person can move it: a person requested changes
#
# --wait polls every 30 seconds while the state is `waiting`, for SECONDS at
# most (default 1800), then prints the state it ends in. Run it in the
# background so the session is woken when it exits.
set -euo pipefail

POLL_SECONDS=30
NEW_COMMIT_GRACE_SECONDS=300

pr=""
wait_for=0
while [ $# -gt 0 ]; do
  case "$1" in
    --wait)
      wait_for=1800
      if [ $# -gt 1 ] && [ "${2#-}" = "$2" ] && [ "$2" -eq "$2" ] 2>/dev/null; then
        wait_for=$2
        shift
      fi
      ;;
    *) pr=$1 ;;
  esac
  shift
done

# shellcheck disable=SC2016 # GraphQL variables, not shell ones
QUERY='query($owner: String!, $name: String!, $number: Int!) {
  repository(owner: $owner, name: $name) {
    pullRequest(number: $number) {
      url state mergeable headRefOid
      commits(last: 1) { nodes { commit { committedDate
        statusCheckRollup { contexts(first: 100) { nodes {
          __typename
          ... on CheckRun { name status conclusion }
          ... on StatusContext { context state }
        } } } } } }
      reviews(last: 100) { nodes { state author { __typename login } commit { oid } } }
      reviewRequests(first: 20) { nodes { requestedReviewer {
        __typename ... on User { login } ... on Bot { login } ... on Team { name } } } }
      reviewThreads(first: 100) { nodes { isResolved isOutdated
        comments(first: 1) { nodes { author { login } path line } } } }
    }
  }
}'

# jq over the PR: one `STATE` line, then the reasons. Precedence: a closed PR,
# then what needs a person, then what Claude can fix, then what is still
# running.
# shellcheck disable=SC2016 # jq variables, not shell ones
EVALUATE='
def ago($t): (now - ($t | fromdateiso8601));
.data.repository.pullRequest as $p
| $p.headRefOid as $head
| ($p.commits.nodes[0].commit) as $c
| [($c.statusCheckRollup.contexts.nodes // [])[]
   | if .__typename == "CheckRun"
     then {name, s: (if .status != "COMPLETED" then "pending"
                     elif (.conclusion | IN("SUCCESS","NEUTRAL","SKIPPED")) then "pass"
                     else "fail" end)}
     else {name: .context, s: (if .state == "PENDING" or .state == "EXPECTED" then "pending"
                               elif .state == "SUCCESS" then "pass" else "fail" end)}
     end] as $checks
| ($p.reviews.nodes | group_by(.author.login) | map(last)) as $latest
# A comment does not withdraw a request for changes; only a newer approval or
# dismissal does, as on GitHub itself.
| [$p.reviews.nodes[] | select(.state | IN("APPROVED","CHANGES_REQUESTED","DISMISSED"))
   | select(.author != null)] as $verdict_reviews
| [$verdict_reviews | group_by(.author.login)[] | last
   | select(.state == "CHANGES_REQUESTED")] as $changes
| [$p.reviewThreads.nodes[] | select((.isResolved | not) and (.isOutdated | not))
   | .comments.nodes[0]] as $threads
| [$latest[] | select(.author.__typename == "Bot" and .commit.oid != $head
                      and .state != "CHANGES_REQUESTED")] as $stale_bots
| [$p.reviewRequests.nodes[].requestedReviewer
   | select(.__typename == "Bot") | .login] as $pending_bots
| if $p.state != "OPEN" then ["ready", "pull request is \($p.state | ascii_downcase)"]
  elif ($changes | map(select(.author.__typename == "User")) | length) > 0 then
    ["person"] + [$changes[] | select(.author.__typename == "User")
                  | "\(.author.login) requested changes; answer them, then ask for a new review"]
  elif ([$checks[] | select(.s == "fail")] | length) > 0
       or ($threads | length) > 0
       or ($changes | length) > 0
       or $p.mergeable == "CONFLICTING" then
    ["action"]
    + [$checks[] | select(.s == "fail") | "check failed: \(.name)"]
    + [$threads[] | "open review thread from \(.author.login): \(.path):\(.line // "?")"]
    + [$changes[] | "\(.author.login) requested changes on \(.commit.oid[0:8])"
       + (if .commit.oid != $head then " (an older commit: ask it to review the latest one)"
          else "" end)]
    + (if $p.mergeable == "CONFLICTING" then ["merge conflict with the base branch"] else [] end)
  elif ([$checks[] | select(.s == "pending")] | length) > 0 then
    ["waiting"] + [$checks[] | select(.s == "pending") | "check running: \(.name)"]
  elif ($checks | length) == 0 and ago($c.committedDate) < $grace then
    ["waiting", "no checks have started on the latest commit yet"]
  elif ($stale_bots | length) > 0 or ($pending_bots | length) > 0 then
    ["waiting"]
    + [$stale_bots[] | "\(.author.login) has not reviewed the latest commit yet"]
    + [$pending_bots[] | "\(.) review requested, not posted yet"]
  else ["ready", "\($checks | length) checks passed, no open review threads"]
  end
| "STATE: \(.[0])", "PR: \($p.url) (head \($head[0:8]))", (.[1:][] | "- \(.)")
'

check() {
  local url="" number repo json=""
  if ! url=$(gh pr view ${pr:+"$pr"} --json url --jq .url 2>/dev/null) || [ -z "$url" ]; then
    echo "STATE: error"
    echo "- no pull request found${pr:+ for $pr}"
    return 3
  fi
  # https://github.com/OWNER/NAME/pull/N
  number=${url##*/}
  repo=${url#https://github.com/}
  repo=${repo%/pull/*}
  if ! json=$(gh api graphql -F number="$number" -F owner="${repo%/*}" \
    -F name="${repo#*/}" -f query="$QUERY" 2>/dev/null); then
    local why
    why=$(jq -r '.errors[0].message // empty' <<<"$json" 2>/dev/null) || why=""
    echo "STATE: error"
    echo "- GitHub could not be read: ${why:-${json:-gh failed}}"
    return 3
  fi
  local out
  out=$(jq -r --argjson grace "$NEW_COMMIT_GRACE_SECONDS" "$EVALUATE" <<<"$json")
  printf '%s\n' "$out"
  case "$(head -n 1 <<<"$out")" in
    "STATE: ready") return 0 ;;
    "STATE: action") return 1 ;;
    "STATE: waiting") return 2 ;;
    "STATE: person") return 4 ;;
    *) return 3 ;;
  esac
}

status=0
check || status=$?
deadline=$((SECONDS + wait_for))
while [ "$wait_for" -gt 0 ] && [ "$status" -eq 2 ] && [ "$SECONDS" -lt "$deadline" ]; do
  sleep "$POLL_SECONDS"
  status=0
  out=$(check) || status=$?
  [ "$status" -eq 2 ] || { printf '%s\n' "$out"; break; }
done
if [ "$wait_for" -gt 0 ] && [ "$status" -eq 2 ]; then
  echo "- still waiting after ${wait_for}s; run pr-ready --wait again"
fi
exit "$status"
